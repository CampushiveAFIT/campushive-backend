# Copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL (Prisma). Example for local dev:
# DATABASE_URL=postgresql://astro@localhost:5432/campus_hive?host=/run/postgresql
DATABASE_URL=

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS - comma-separated allowed origins (Vite default port 5173)
CORS_ORIGIN=http://localhost:5173

# Redis - required in production. In development/test, an embedded
# in-memory Redis-compatible server is started automatically when unset.
REDIS_URL=

# Email (development default: console adapter)
EMAIL_FROM=noreply@campushive.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
