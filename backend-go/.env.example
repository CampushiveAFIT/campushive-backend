NODE_ENV=development
PORT=3000
LOG_LEVEL=info
AUTO_MIGRATE=false

# Required in every environment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_hive?schema=public&connection_limit=10
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Required when NODE_ENV=production. In development an embedded Redis server is
# started automatically when REDIS_URL is unset.
REDIS_URL=redis://localhost:6379
# REDIS_SERVER_BINARY=/usr/local/bin/redis-server

CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=loopback
MAX_BODY_BYTES=1048576
OUTBOX_POLL_INTERVAL_MS=2000

EMAIL_FROM=noreply@campushive.com
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
